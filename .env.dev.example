# Dev pair env file (orchestrator-dev + tool_service-dev, compose profile
# `dev`). Copy to .env.dev (gitignored) and edit per experiment:
#   cp .env.dev.example .env.dev
# Changes take effect on the next
#   docker compose --profile dev up -d tool_service-dev orchestrator-dev
# (compose recreates a service whose env_file changed).
#
# Only knobs live here. Wiring (service URLs, OTEL service names, data
# paths) is in docker-compose.yml; secrets (HA_TOKEN, MA_TOKEN,
# SOLAR_SERIAL) come from .env by interpolation and are not repeated here.

# ── tool_service-dev ─────────────────────────────────────────────────────
# Music dry run: requests resolve and answer with what would have played;
# nothing is sent to a player or Music Assistant. Keep it on. For a test
# that must make sound, set 0, use the office speaker, then set it back.
MUSIC_DRY_RUN=1
# Where music goes when the request names no speaker and has no origin
# (the /dev/ chat shims). The office speaker is the one for audible tests.
MUSIC_DEFAULT_PLAYER=media_player.satellite1_d8d1bc

# ── orchestrator-dev ─────────────────────────────────────────────────────
# Model assignments (same meaning as in docker-compose.yml's orchestrator).
COORDINATOR_MODEL=gemma-4-e4b
RESEARCH_AGENT_MODEL=gemma-4-e4b
CODING_AGENT_MODEL=gemma-4-e4b
DEVOPS_AGENT_MODEL=gemma-4-e4b
TALKIE_MODEL=talkie
LOCATION=Laurel, MD
HISTORY_MAX_MESSAGES=40
# debug | friendly (orchestrator/errors.py). Dev stays on debug for
# /message, /api/chat and /v1.
ERROR_STYLE=debug
# The speech mount (/voice/api/chat) defaults to friendly in code;
# uncomment to hear debug wording there.
# ERROR_STYLE_VOICE=debug
# Prompt/answer previews on spans. Off, as in production.
TELEMETRY_RECORD_TEXT=false
