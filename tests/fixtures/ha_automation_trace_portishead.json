         }
        ],
        "else": [
         {
          "alias": "Say it failed",
          "set_conversation_response": "I couldn't play {{ trigger.slots.media_name }}{{ ' radio' if action_data.media_type == 'radio' and 'radio' not in trigger.slots.media_name | lower else '' }}."
         }
        ]
       }
      ]
     }
    ]
   }
