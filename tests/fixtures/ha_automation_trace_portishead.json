  "actions": [
   {
    "alias": "Define variables to be used in the automation",
    "variables": {
     "version": "20250404-kronk12",
     "shuffle": "{{ 'shuffle' in trigger.sentence | lower }}",
     "default_player_entity_id": "media_player.home_assistant_voice_0ac919_pe_01",
     "trigger_id": "{{ trigger.id }}",
     "area_or_player_name": "{{ trigger.slots.area_or_player_name | default }}",
     "assist_device_id": "{{ trigger.device_id }}",
     "action_data": {
      "media_id": "{%- set n = trigger.slots.media_name | trim -%} {%- if trigger.id == 'radio' and not (n | lower).endswith(' radio') -%}{{ n }} Radio {%- else -%}{{ n }}{%- endif -%}",
      "media_type": "{{ 'radio' if 'radio' in media_name | lower else trigger_id }}",
      "artist": "{{ trigger.slots.artist | default }}",
      "radio_mode": "{{ 'radio' in trigger.slots.radio_mode | default | lower }}"
     },
     "ma_players": "{{  integration_entities('music_assistant') | select('match', 'media_player') | list }}",
     "player_entity_id_by_player_name": "{{ ma_players | expand \n  | selectattr('name', 'match', area_or_player_name ~ '$', ignorecase=true)\n  | map(attribute='entity_id') | list }}\n",
     "player_entity_id_by_area_name": "{%- set ps = areas() | map('area_name') | select('match', area_or_player_name ~ '$', ignorecase=true)\n   | map('area_entities') | sum(start=[]) | select('in', ma_players) | list -%}\n{%- set gs = ps | select('is_state_attr', 'mass_player_type', 'group') | list -%} {{ gs or ps }}",
     "assist_device_mac": "{%- if assist_device_id -%} {{ device_attr(assist_device_id, 'connections') | selectattr(0, 'eq', 'mac') | map(attribute=1) | first | default('') }} {%- endif -%}",
     "player_entity_id_by_assist_device": "{%- set ns = namespace(hits=[]) -%} {%- if assist_device_mac -%}\n  {%- set key = 'up' ~ (assist_device_mac | replace(':', '')) -%}\n  {%- for e in ma_players -%}\n    {%- set ids = device_attr(device_id(e), 'identifiers') | list -%}\n    {%- if ids | selectattr(1, 'eq', key) | list -%}{%- set ns.hits = ns.hits + [e] -%}{%- endif -%}\n  {%- endfor -%}\n{%- endif -%} {{ ns.hits }}",
     "player_entity_id_by_assist_area": "{%- set ps = (area_entities(area_id(assist_device_id)) | select('in', ma_players) | list) if assist_device_id else [] -%} {%- set gs = ps | select('is_state_attr', 'mass_player_type', 'group') | list -%} {{ gs or ps }}",
     "mass_player_entity_id": "{{ player_entity_id_by_player_name or player_entity_id_by_area_name \nor player_entity_id_by_assist_device or player_entity_id_by_assist_area or [default_player_entity_id] }}\n",
     "mass_player_name": "{{ mass_player_entity_id | map('state_attr', 'friendly_name') | join(', ') }}",
     "mass_player_where": "{%- set room = area_name(mass_player_entity_id[0]) if mass_player_entity_id else none -%} {%- if player_entity_id_by_player_name or not room -%}on {{ mass_player_name }} {%- else -%}in the {{ room }}{%- endif -%}"
    }
   },
   {
    "variables": {
     "kronk_agent": "conversation.ollama_conversation",
     "kronk_text": "{%- set room = area_name(assist_device_id) if assist_device_id else none -%} {%- set own = player_entity_id_by_assist_device | first | default(none) -%} {%- if area_or_player_name -%}{{ trigger.sentence }} {%- elif room -%}{{ trigger.sentence }} in the {{ room }} {%- elif own -%}{{ trigger.sentence }} on the {{ state_attr(own, 'friendly_name') }} {%- else -%}{{ trigger.sentence }}{%- endif -%}"
    }
   },
   {
    "alias": "Loose phrasing or catch-all \u2014 Kronk picks",
    "if": [
     {
      "condition": "template",
      "value_template": "{{ trigger_id in ['loose', 'catchall'] }}"
     }
    ],
    "then": [
     {
      "action": "conversation.process",
      "continue_on_error": true,
      "data": {
       "agent_id": "{{ kronk_agent }}",
       "text": "{{ kronk_text }}"
      },
      "response_variable": "kronk"
     },
     {
      "set_conversation_response": "{{ kronk.response.speech.plain.speech if kronk is defined and kronk.response is defined\n   else \"I couldn't reach Kronk.\" }}"
     }
    ],
    "else": [
     {
      "alias": "Snapshot what the target is playing",
      "variables": {
       "verify_entity": "{{ mass_player_entity_id[0] }}",
       "before_content": "{{ state_attr(mass_player_entity_id[0], 'media_content_id') }}",
       "before_title": "{{ state_attr(mass_player_entity_id[0], 'media_title') }}",
       "before_position": "{{ state_attr(mass_player_entity_id[0], 'media_position') | float(0) }}",
       "before_state": "{{ states(mass_player_entity_id[0]) }}"
      }
     },
     {
      "variables": {
       "play_ok": false,
       "started": false
      }
     },
     {
      "alias": "Set shuffle before the play",
      "if": [
       {
        "condition": "template",
        "value_template": "{{ state_attr(mass_player_entity_id[0], 'shuffle') != shuffle }}"
       }
      ],
      "then": [
       {
        "action": "media_player.shuffle_set",
        "continue_on_error": true,
        "data": {
         "shuffle": "{{ shuffle }}"
        },
        "target": {
         "entity_id": "{{ mass_player_entity_id }}"
        }
       }
      ]
     },
     {
      "alias": "Send media to selected Music Assistant Player",
      "continue_on_error": true,
      "sequence": [
       {
        "action": "music_assistant.play_media",
        "data": "{{ dict(action_data.items() | selectattr('1')) }}",
        "target": {
         "entity_id": "{{ mass_player_entity_id }}"
        }
       },
       {
        "variables": {
         "play_ok": true
        }
       }
      ]
     },
     {
      "alias": "Wait for the player to start the new media",
      "if": [
       {
        "condition": "template",
        "value_template": "{{ play_ok }}"
       }
      ],
      "then": [
       {
        "wait_template": "{{ is_state(verify_entity, 'playing') and (\n     before_state != 'playing'\n     or state_attr(verify_entity, 'media_content_id') != before_content\n     or state_attr(verify_entity, 'media_title') != before_title\n     or (state_attr(verify_entity, 'media_position') | float(0)) < before_position ) }}",
        "timeout": "00:00:10",
        "continue_on_timeout": true
       },
       {
        "variables": {
         "started": "{{ wait.completed }}"
        }
       }
      ]
     },
     {
      "if": [
       {
        "condition": "template",
        "value_template": "{{ started }}"
       }
      ],
      "then": [
       {
        "alias": "Enable/Disable shuffle on a Music Assistant Media Player",
        "if": [
         {
          "condition": "template",
          "value_template": "{{ state_attr(mass_player_entity_id[0], 'shuffle') != shuffle }}"
         }
        ],
        "then": [
         {
          "action": "media_player.shuffle_set",
          "continue_on_error": true,
          "data": {
           "shuffle": "{{ shuffle }}"
          },
          "target": {
           "entity_id": "{{ mass_player_entity_id }}"
          }
         }
        ]
       },
       {
        "alias": "Send back the response",
        "set_conversation_response": "{{ 'Shuffling' if 'shuffle' in trigger.sentence | lower  else ''}} {{ trigger.slots.media_name }} {{ '' if 'shuffle' in trigger.sentence | lower else 'playing'}} {{ mass_player_where }}"
       }
      ],
      "else": [
       {
        "if": [
