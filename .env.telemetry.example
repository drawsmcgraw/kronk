# Grafana admin login for the telemetry stack (docker-compose.telemetry.yml).
# Copy to .env.telemetry (gitignored, chmod 600) and set a real password:
#   cp .env.telemetry.example .env.telemetry && chmod 600 .env.telemetry
#   sed -i "s/change-me/$(openssl rand -base64 18)/" .env.telemetry
# Anonymous LAN users can view dashboards; this login edits them.
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me
