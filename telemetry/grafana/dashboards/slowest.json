   "id": 1,
   "type": "text",
   "title": "",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   },
   "options": {
    "mode": "markdown",
    "content": "Traces slower than **$min** in the time range (Tempo returns the first matches, so tighten the range or raise the threshold for a true top-N). Click a trace ID to open the waterfall. `kronk.rid` matches the `rid` in the orchestrator's `kronk.events` log lines, which also carry `trace_id`."
   }
  },
  {
   "id": 2,
   "type": "table",
   "title": "Slow Kronk requests",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 24,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "query": "{ name =~ \"pipeline\\\\..*\" && duration > $min }",
     "filters": [],
     "limit": 50,
     "tableType": "traces",
     "metricsQueryType": "range",
     "step": "",
     "spss": 3
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "sortBy": [
