     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "voice.stt = stream start \u2192 transcript (listen + transcribe); voice.intent = HA intent match, blueprint or Kronk; voice.tts = TTS request (streamed, so near zero)"
