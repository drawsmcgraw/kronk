    "w": 24,
    "h": 3
   },
   "options": {
    "mode": "markdown",
    "content": "**p50 / p95 per stage over time.** Voice front half (HA), blueprint, Kronk routing, LLM rounds (time to first token and generation separately), tools, and tool internals (Music Assistant commands, HA service calls, the playback-verify wait)."
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Voice stages: STT / intent / TTS",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "query": "{ name =~ \"voice\\\\.(stt|intent|tts)\" } | quantile_over_time(duration, .5, .95) by (name)",
     "filters": [],
     "limit": 20,
     "tableType": "traces",
     "metricsQueryType": "range",
     "step": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8,
      "spanNulls": true,
