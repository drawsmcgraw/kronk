   "id": 1,
   "type": "text",
   "title": "",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   },
   "options": {
    "mode": "markdown",
    "content": "**`play_music` and the blueprint fast path.** Kronk path: `tool.play_music` \u2192 tool_service `POST /music` \u2192 `music.resolve` (MA search + scoring) / `music.pandora_station` / `music.genre_plan` \u2192 `music.play_verified` (HA `play_media` over websocket, then polling the player until it plays something new). Fast path: `blueprint.run` (HA sentence trigger \u2192 MA directly), joined to its voice run by time window."
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Kronk path: play_music breakdown p50 / p95",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "query": "{ resource.service.name = \"kronk-tool-service\" && name =~ \"music\\\\..*\" } | quantile_over_time(duration, .5, .95) by (name)",
     "filters": [],
     "limit": 20,
     "tableType": "traces",
     "metricsQueryType": "range",
     "step": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8,
      "spanNulls": true,
      "showPoints": "auto",
      "pointSize": 4
     }
    },
    "overrides": []
   },
   "options": {
