# Exports the state of the work items to data/work.json and
# data/dev/work.json, for /work (work items M27, M34): the items, the queue,
# their steps, stages and promotions from the dump of the work-state
# database (~/.local/state/kronk-work/work.db.dump.sql, which scripts/work.py
# rewrites after every write; the database itself is never opened), the
# backlog from ROADMAP.md, and which agents herdr shows working. Fired by
# kronk-work-export.timer every 60 s. Loads scripts/work.py from the
# working tree for its read-only overview(). Runs only `git rev-parse`,
# `git for-each-ref` and `git rev-list HEAD` with GIT_OPTIONAL_LOCKS=0
# (never `git status`, which takes the index lock an agent's commit needs)
# and `herdr agent list`. The script itself stops waiting for herdr after
# 5 s; TimeoutStartSec stops a hung run here. See docs/features/work-page.md.
#
# StartLimitIntervalSec=0 turns off systemd's start limit (by default five
# starts in ten seconds). kronk-work-export.path starts this service on
# every write of the work-state dump, and a burst of writes (a chain of
# work.py commands at a promotion, an agent's launch beside it) passed the
# limit: the service failed with start-limit-hit and the path unit failed
# with it for good, so every later write waited for the timer, silently
# (M32 step 1 test, S1). The service is a oneshot, so runs still never
# overlap; a burst costs a few back-to-back exports.
#
# Operations:
#   install:  cp systemd/kronk-work-export.{service,timer} ~/.config/systemd/user/
#             systemctl --user daemon-reload
#             systemctl --user enable --now kronk-work-export.timer
#   check:    systemctl --user list-timers kronk-work-export.timer
#             journalctl --user -u kronk-work-export.service -n 20
#   one-shot: python3 scripts/work_export.py --print
#             python3 scripts/work_export.py --db <copy> --print   (a scratch copy and its dump)
#   remove:   systemctl --user disable --now kronk-work-export.timer
#             rm ~/.config/systemd/user/kronk-work-export.{service,timer}
#             systemctl --user daemon-reload
[Unit]
Description=Kronk — export the work items for /work
StartLimitIntervalSec=0

[Service]
Type=oneshot
TimeoutStartSec=30
ExecStart=/usr/bin/python3 -B /home/drew/git-repos/drawsmcgraw/kronk/scripts/work_export.py
