# Quarterly major-release check (sprint M18): scripts/upgrade_major_check.sh
# writes the impact report to docs/upgrades/<date>.md (committed when the
# tree is clean and on the expected branch (see kronk-upgrade-minor.service); otherwise under
# data/upgrades/reports/), then tells Drew one or more major upgrades need
# scheduling, with the report's path. It upgrades nothing.
# Fired by kronk-upgrade-major-check.timer.
#
# Operations: install, check, remove as in kronk-upgrade-minor.service.
#   dry run:   scripts/upgrade_major_check.sh --dry-run    (prints the report; writes and sends nothing)
#   run now:   systemctl --user start kronk-upgrade-major-check.service
#   log:       journalctl --user -u kronk-upgrade-major-check.service -n 50
[Unit]
Description=Kronk — quarterly major-upgrade report (M18)

[Service]
Type=oneshot
ExecStart=%h/git-repos/drawsmcgraw/kronk/scripts/upgrade_major_check.sh
WorkingDirectory=%h/git-repos/drawsmcgraw/kronk
Environment=KRONK_REPO_DIR=%h/git-repos/drawsmcgraw/kronk
TimeoutStartSec=30m
