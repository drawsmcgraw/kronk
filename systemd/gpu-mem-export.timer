# Fires gpu-mem-export.service every 30 s. The orchestrator treats
# data/gpu_mem.json older than 120 s as stale: /resources then shows each
# server's state as unknown and says STALE with the file's age (M25; there
# is no estimate to fall back to).
[Unit]
Description=Kronk — GPU memory export every 30s

[Timer]
OnBootSec=30
OnUnitActiveSec=30
AccuracySec=5

[Install]
WantedBy=timers.target
