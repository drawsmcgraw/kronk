# Fires kronk-upgrade-minor.service at 03:30 local on days 1-7 of each month.
# The first run that is not declined does the month; the others find it done
# and exit. Persistent: a night the box was off fires at the next boot; that
# catch-up runs only inside the night window (settings.night_window, default
# 02:00-05:00), so at any other hour it declines and the next night's firing
# runs (a missed day 7 is then next month's).
# Install and remove: the Operations block in kronk-upgrade-minor.service.
[Unit]
Description=Kronk — monthly patch upgrades, days 1-7 at 03:30 (M18)

[Timer]
OnCalendar=*-*-01..07 03:30
Persistent=true
RandomizedDelaySec=10m

[Install]
WantedBy=timers.target
